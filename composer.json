{
    "name": "gspataro/orchestra",
    "description": "The framework behind Solista",
    "license": "MIT",
    "authors": [
        {
            "name": "Giuseppe Spataro",
            "homepage": "https://giuseppespataro.it"
        }
    ],
    "require": {
        "gspataro/dependencyinjection": "^1.0.0",
        "gspataro/cli": "^2.0.0",
        "nunomaduro/collision": "^8.9",
        "twig/twig": "^3.7.1",
        "twig/string-extra": "^3.7.1",
        "twig/intl-extra": "^3.21.0",
        "league/commonmark": "^2.4.1",
        "symfony/yaml": "^6.3.3",
        "tempest/highlight": "^1.3.3"
    },
    "autoload": {
        "psr-4": {
            "Orchestra\\": "src/Orchestra/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Orchestra\\Test\\": "tests"
        }
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.1"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "./vendor/bin/pest",
        "test:unit": "./vendor/bin/pest --group=unit",
        "phpstan": "./vendor/bin/phpstan --memory-limit=1G"
    }
}

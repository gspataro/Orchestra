{
    "website": {
        "name": "Test Project",
        "description": "Orchestra test project",
        "theme": "test",
        "friendly_urls": true
    },
    "contents": {
        "articles": {
            "files": "articles/*.md",
            "reader": "markdown",
            "relationships": [
                {
                    "with": "categories",
                    "field": "metadata.slug",
                    "operator": "containsAny",
                    "value": "metadata.categories"
                }
            ]
        },
        "categories": {
            "files": "categories/*.json",
            "reader": "json",
            "relationships": [
                {
                    "with": "articles",
                    "field": "metadata.categories",
                    "operator": "containsAny",
                    "value": "metadata.slug"
                }
            ]
        }
    },
    "schemas": {
        "index": {
            "draft": false,
            "template": "page",
            "slug": "/index",
            "generate": "once"
        },
        "future": {
            "draft": true,
            "template": "page",
            "slug": "/future",
            "generate": "once"
        },
        "article": {
            "contents": [
                "articles"
            ],
            "template": "page",
            "slug": "/articolo",
            "generate": "loop",
            "source": "articles"
        },
        "blog": {
            "contents": [
                "articles"
            ],
            "template": "page",
            "slug": "/blog",
            "generate": "archive",
            "source": "articles",
            "options": {
                "per_page": 12
            }
        },
        "categories": {
            "contents": [
                "categories"
            ],
            "template": "page",
            "slug": "/categoria",
            "generate": "collection",
            "source": "categories",
            "options": {
                "per_page": "12",
                "fillWith": "articles"
            }
        }
    }
}
